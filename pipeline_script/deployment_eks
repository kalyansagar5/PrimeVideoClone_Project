pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        KUBECTL = '/usr/local/bin/kubectl'
    }

    parameters {
        string(
            name: 'CLUSTER_NAME',
            defaultValue: 'amazon-prime-cluster',
            description: 'EKS cluster name'
        )

        string(
            name: 'ECR_REPO_NAME',
            defaultValue: 'amazon-prime',
            description: 'ECR repository name'
        )

        string(
            name: 'VERSION',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
    }

    stages {

        stage('Check Parameters') {
            steps {
                script {
                    if (!params.CLUSTER_NAME?.trim()) {
                        error("CLUSTER_NAME is empty. Please enter amazon-prime-cluster.")
                    }

                    if (!params.ECR_REPO_NAME?.trim()) {
                        error("ECR_REPO_NAME is empty.")
                    }

                    if (!params.VERSION?.trim()) {
                        error("VERSION is empty.")
                    }

                    echo "======================================"
                    echo "PIPELINE PARAMETERS"
                    echo "======================================"
                    echo "Cluster     : ${params.CLUSTER_NAME}"
                    echo "Region      : ${env.AWS_DEFAULT_REGION}"
                    echo "ECR Repo    : ${params.ECR_REPO_NAME}"
                    echo "Version     : ${params.VERSION}"
                    echo "======================================"
                }
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "CHECKING TOOLS"
                    echo "======================================"

                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "kubectl:"
                    $KUBECTL version --client

                    echo ""
                    echo "Tools check completed."
                '''
            }
        }

        stage('Login to EKS') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'access-key',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'secret-key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    script {
                        // Explicitly pass Jenkins parameter to environment
                        env.EKS_CLUSTER_NAME = params.CLUSTER_NAME.trim()

                        sh '''
                            set -e

                            echo "======================================"
                            echo "CONNECTING TO EKS"
                            echo "======================================"

                            echo "Cluster : $EKS_CLUSTER_NAME"
                            echo "Region  : $AWS_DEFAULT_REGION"

                            if [ -z "$EKS_CLUSTER_NAME" ]; then
                                echo "ERROR: EKS_CLUSTER_NAME is empty."
                                exit 1
                            fi

                            aws eks describe-cluster \
                                --region "$AWS_DEFAULT_REGION" \
                                --name "$EKS_CLUSTER_NAME" \
                                --query "cluster.status" \
                                --output text

                            aws eks update-kubeconfig \
                                --region "$AWS_DEFAULT_REGION" \
                                --name "$EKS_CLUSTER_NAME"

                            echo ""
                            echo "Current Kubernetes context:"
                            $KUBECTL config current-context

                            echo ""
                            echo "EKS nodes:"
                            $KUBECTL get nodes

                            echo ""
                            echo "EKS connection successful."
                        '''
                    }
                }
            }
        }

        stage('Get AWS Account ID') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'access-key',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'secret-key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "AWS Account ID: ${env.AWS_ACCOUNT_ID}"
                    }
                }
            }
        }

        stage('Prepare Deployment Image') {
            steps {
                script {
                    env.ECR_IMAGE = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com/${params.ECR_REPO_NAME}:${params.VERSION}"

                    echo "======================================"
                    echo "APPLICATION IMAGE"
                    echo "======================================"
                    echo "${env.ECR_IMAGE}"
                }

                sh '''
                    set -e

                    echo "======================================"
                    echo "PREPARING KUBERNETES MANIFEST"
                    echo "======================================"

                    if [ ! -f k8s_files/deployment.yaml ]; then
                        echo "ERROR: k8s_files/deployment.yaml not found."
                        exit 1
                    fi

                    if [ ! -f k8s_files/service.yaml ]; then
                        echo "ERROR: k8s_files/service.yaml not found."
                        exit 1
                    fi

                    sed "s|image:.*|image: $ECR_IMAGE|" \
                        k8s_files/deployment.yaml \
                        > k8s_files/deployment.generated.yaml

                    echo ""
                    echo "Image configured:"
                    grep "image:" k8s_files/deployment.generated.yaml
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "DEPLOYING APPLICATION"
                    echo "======================================"

                    $KUBECTL apply \
                        -f k8s_files/deployment.generated.yaml

                    $KUBECTL apply \
                        -f k8s_files/service.yaml

                    echo ""
                    echo "Kubernetes resources applied."
                '''
            }
        }

        stage('Check Deployment') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "CHECKING DEPLOYMENT"
                    echo "======================================"

                    echo ""
                    echo "Deployments:"
                    $KUBECTL get deployments

                    echo ""
                    echo "Pods:"
                    $KUBECTL get pods -o wide

                    echo ""
                    echo "Services:"
                    $KUBECTL get svc
                '''
            }
        }

        stage('Wait for Application') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "WAITING FOR APPLICATION"
                    echo "======================================"

                    DEPLOYMENT_NAME=$(
                        $KUBECTL get deployment \
                        -o jsonpath='{.items[0].metadata.name}'
                    )

                    if [ -z "$DEPLOYMENT_NAME" ]; then
                        echo "ERROR: No Kubernetes deployment found."
                        exit 1
                    fi

                    echo "Deployment: $DEPLOYMENT_NAME"

                    $KUBECTL rollout status \
                        deployment/$DEPLOYMENT_NAME \
                        --timeout=10m

                    echo ""
                    echo "Application rollout completed."
                '''
            }
        }

        stage('Final Verification') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "FINAL VERIFICATION"
                    echo "======================================"

                    echo ""
                    echo "NODES:"
                    $KUBECTL get nodes -o wide

                    echo ""
                    echo "DEPLOYMENTS:"
                    $KUBECTL get deployments

                    echo ""
                    echo "PODS:"
                    $KUBECTL get pods -o wide

                    echo ""
                    echo "SERVICES:"
                    $KUBECTL get svc

                    echo ""
                    echo "======================================"
                    echo "APPLICATION DEPLOYMENT COMPLETED"
                    echo "======================================"
                '''
            }
        }
    }

    post {
        success {
            echo '''
======================================
DEPLOYMENT PIPELINE SUCCESS
======================================

EKS         : CONNECTED
ECR IMAGE   : CONFIGURED
KUBERNETES  : DEPLOYED
APPLICATION : VERIFIED

======================================
'''
        }

        failure {
            echo '''
======================================
DEPLOYMENT PIPELINE FAILED
======================================

Check the failed stage above.

======================================
'''
        }

        always {
            sh '''
                rm -f k8s_files/deployment.generated.yaml || true
            '''
        }
    }
}
